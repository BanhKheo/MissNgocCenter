{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "prisma:generate": {
      "inputs": [
        "prisma/schema.prisma"
      ],
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "prisma:generate"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "prisma:generate"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
