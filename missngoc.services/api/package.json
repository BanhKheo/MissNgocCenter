{
  "name": "missngoc.api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS: api (HTTP) + worker (chấm bài)",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "worker": "node dist/worker.js",
    "worker:dev": "nest start --watch --entryFile worker",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/scripts/seed-rbac.ts",
    "db:demo": "tsx src/scripts/seed-demo.ts",
    "db:setup": "prisma migrate deploy && tsx src/scripts/seed-rbac.ts && tsx src/scripts/bootstrap-admin.ts",
    "admin:bootstrap": "tsx src/scripts/bootstrap-admin.ts",
    "poc": "tsx src/scripts/poc.ts",
    "test:unit": "tsx --test \"src/**/*.unit.spec.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@google/genai": "^2.30.0",
    "@missngoc/core": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "~6.19.0",
    "argon2": "^0.45.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg-boss": "^10.4.2",
    "prisma": "~6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
