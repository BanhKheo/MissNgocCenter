# File .env cho máy dev. Chép thành .env rồi điền giá trị.
# Postgres chạy bằng: npm run db:up (ở thư mục gốc repo)
DATABASE_URL=postgresql://grader:grader-dev@localhost:5432/grader

PORT=3000
# Máy dev: chạy worker chung tiến trình api, chỉ cần 1 lệnh. Docker Compose thật thì để false, worker chạy riêng.
WORKER_IN_PROCESS=true
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-64-ky-tu
JWT_EXPIRES_IN=30d
UPLOAD_DIR=./data/uploads
# Địa chỉ web cho mã QR "mở trên điện thoại". Trống thì tự lấy IP LAN của máy
PUBLIC_URL=

# Engine đọc ảnh: gemini | claude | mock
#   mock: không gọi AI, trả kết quả giả để thử giao diện
#   gemini: cần GEMINI_API_KEY (tạo ở https://aistudio.google.com)
#   claude: cần ANTHROPIC_API_KEY (tạo ở Claude Console)
# Ghi nhiều engine ngăn bằng dấu phẩy để dự phòng, ví dụ gemini,claude:
#   bài nào Gemini lỗi hoặc hết lượt thì Claude đọc thay. Engine hết lượt (lỗi 429) được nghỉ FALLBACK_COOLDOWN_MINUTES phút.
GRADING_ENGINE=mock
FALLBACK_COOLDOWN_MINUTES=15
# Số bài đọc song song. Gemini miễn phí giới hạn vài yêu cầu/phút và 20 yêu cầu/ngày: nên để 2
GRADING_CONCURRENCY=2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=
GRADING_MODEL=claude-opus-5-5
GRADING_EFFORT=low

# Chỉ dùng cho lệnh tạo admin; xoá ADMIN_PASSWORD sau khi đăng nhập lần đầu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
