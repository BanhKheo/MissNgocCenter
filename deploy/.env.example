# deploy/.env.example — chép thành deploy/.env trên máy chủ. File .env thật không đưa lên git.
APP_VERSION=1.0.0
# Cổng web trên máy chủ. Windows đôi khi đã dùng cổng 80 (IIS, HTTP.sys): khi đó đặt 8080
WEB_PORT=80
# Địa chỉ web trong mạng LAN, dùng cho mã QR trên giao diện (IP đặt cố định trên router)
PUBLIC_URL=http://192.168.1.10
DB_PASSWORD=doi-thanh-mat-khau-dai-ngau-nhien
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-64-ky-tu
JWT_EXPIRES_IN=30d

# Engine đọc ảnh: gemini | claude | mock. Nhiều engine ngăn bằng dấu phẩy để dự phòng, ví dụ gemini,claude
GRADING_ENGINE=claude
FALLBACK_COOLDOWN_MINUTES=15
GRADING_CONCURRENCY=5

# Claude API (Claude Console). Đặt hạn mức chi tiêu tháng trên Console.
ANTHROPIC_API_KEY=sk-ant-...
GRADING_MODEL=claude-opus-5-5
GRADING_EFFORT=low

# Gemini API (Google AI Studio). Bản miễn phí chỉ để thử, không dùng bài thật của học sinh.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Chỉ dùng cho lệnh tạo admin; xoá ADMIN_PASSWORD sau khi đăng nhập lần đầu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
